<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
  <sys:String x:Key="WindowTitle">Skill Organizer for Codex</sys:String>
  <sys:String x:Key="WorkbenchAccessibleName">Skill 清单与管理工作台</sys:String>
  <sys:String x:Key="LoadingTitle">正在启动 Skill Organizer</sys:String>
  <sys:String x:Key="LoadingDetail">正在连接本地服务并验证协议兼容性…</sys:String>
  <sys:String x:Key="RetryButton">重试</sys:String>
  <sys:String x:Key="OpenInBrowserButton">在浏览器中打开</sys:String>
  <sys:String x:Key="LaunchFailed">Skill Organizer 启动失败</sys:String>
  <sys:String x:Key="LaunchFailureFormat">Skill Organizer 启动失败：{0}</sys:String>
  <sys:String x:Key="ActivationFailed">无法激活已有窗口，请稍候再试。</sys:String>
  <sys:String x:Key="ProtocolMismatchTitle">需要重启</sys:String>
  <sys:String x:Key="BrowserFallbackTitle">已回退到默认浏览器</sys:String>
  <sys:String x:Key="BrowserFallbackForced">当前开发运行已禁用内嵌浏览器。</sys:String>
  <sys:String x:Key="WebViewFallbackFormat">WebView2 Runtime 不可用或初始化失败。请安装 Microsoft Edge WebView2 Runtime 后重试；在此之前，工作台已在默认浏览器中打开。详情：{0}</sys:String>
  <sys:String x:Key="TrayShow">显示工作台</sys:String>
  <sys:String x:Key="TrayRescan">重新扫描 Skill</sys:String>
  <sys:String x:Key="TrayManagement">管理模式</sys:String>
  <sys:String x:Key="TrayStartupSettings">开机启动设置</sys:String>
  <sys:String x:Key="TrayExit">退出</sys:String>
  <sys:String x:Key="InvalidNodeOverride">CSO_NODE_PATH 必须指向现有的 node.exe 绝对路径。</sys:String>
  <sys:String x:Key="NoInstallLayout">未找到固定运行时或已构建服务。请重新安装 Skill Organizer，或执行发布健康检查。</sys:String>
  <sys:String x:Key="InvalidCurrentPointer">current.json 无效或指向产品目录之外。</sys:String>
  <sys:String x:Key="CurrentVersionMissing">当前 Skill Organizer 版本缺失，请使用安装器修复或回滚。</sys:String>
  <sys:String x:Key="MissingMcpSidecar">安装包中的 MCP sidecar 缺失。</sys:String>
  <sys:String x:Key="McpStartFailed">无法启动安装包中的 MCP sidecar。</sys:String>
  <sys:String x:Key="ServiceStartFailed">无法启动安装包中的本地服务。</sys:String>
  <sys:String x:Key="ServiceExitedFormat">本地服务尚未就绪就已退出（退出代码 {0}）。</sys:String>
  <sys:String x:Key="ServiceTimeout">本地服务在 45 秒内未达到健康状态。</sys:String>
  <sys:String x:Key="ProtocolMismatchFormat">已有本地服务正在使用协议 {0}，当前桌面版支持 {1}。请先重启 Codex 和 Skill Organizer，再执行写操作。</sys:String>
  <sys:String x:Key="CodexCliMissing">未在显式路径或已知宿主位置找到 Codex CLI，插件安装保持待处理状态。</sys:String>
  <sys:String x:Key="PluginInstallFailed">Codex 未能完成可选插件安装，桌面版安装不受影响。</sys:String>
  <sys:String x:Key="NavigationFailedFormat">内嵌工作台未能完成加载（{0}），你可以重试或在浏览器中打开。</sys:String>
</ResourceDictionary>
